NODE_ENV=production
PORT=3000
SERVER_HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://secmynet:replace-with-password@127.0.0.1:5432/secmynet?sslmode=disable

# InfluxDB v2.7
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=replace-with-influx-token
INFLUXDB_ORG=secmynet
INFLUXDB_BUCKET=router-telemetry

# Firebase Admin SDK. Prefer the file path on EC2 so JSON is not shell-escaped.
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secmynet/firebase-service-account.json

# Optional SMS fallback
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
