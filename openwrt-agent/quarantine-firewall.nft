# /etc/nftables.d/secmynet-quarantine.nft
# SecMyNet Zero-Trust Quarantine-First Firewall Rules for OpenWrt (nftables)
#
# Blocks ALL Internet (WAN) forwarding for all quarantined clients (both IPv4 and IPv6).
# Drops packets at Layer 2 (bridge & netdev ingress) and Layer 3 (inet prerouting & forward).
# Preserves local DHCP (ports 67,68) and DNS (port 53) to local router.
# Redirects HTTP port 80 to port 8080 (SecMyNet Holding Captive Portal).

table bridge secmynet_br {
    set quarantined_macs {
        type ether_addr
        comment "SecMyNet quarantined client MACs"
    }

    chain prerouting {
        type filter hook prerouting priority -300; policy accept;

        # 1. Allow local DHCP to router
        ether type ip ip protocol udp udp dport 67 accept
        ether type ip ip protocol udp udp dport 68 accept

        # 2. Allow local DNS to router
        ether type ip ip protocol udp udp dport 53 accept
        ether type ip ip protocol tcp tcp dport 53 accept
        ether type ip6 ip6 nexthdr udp udp dport 53 accept
        ether type ip6 ip6 nexthdr tcp tcp dport 53 accept

        # 3. Allow HTTP port 80 to captive portal
        ether type ip ip protocol tcp tcp dport 80 accept

        # 4. Strictly DROP ALL OTHER PACKETS AT BRIDGE PREROUTING (both IPv4 and IPv6)
        ether saddr @quarantined_macs counter drop
    }

    chain forward {
        type filter hook forward priority -300; policy accept;

        # Allow DHCP
        ether type ip ip protocol udp udp dport 67 accept
        ether type ip ip protocol udp udp dport 68 accept

        # Strictly DROP all other bridge forwarding
        ether saddr @quarantined_macs counter drop
    }
}

table netdev secmynet_l2 {
    set quarantined_macs {
        type ether_addr
        comment "SecMyNet quarantined client MACs"
    }

    chain ingress_br_lan {
        type filter hook ingress device "br-lan" priority -500; policy accept;

        # 1. Allow local DHCP to router
        ether type ip ip protocol udp udp dport 67 accept
        ether type ip ip protocol udp udp dport 68 accept

        # 2. Allow local DNS to router
        ether type ip ip protocol udp udp dport 53 accept
        ether type ip ip protocol tcp tcp dport 53 accept
        ether type ip6 ip6 nexthdr udp udp dport 53 accept
        ether type ip6 ip6 nexthdr tcp tcp dport 53 accept

        # 3. Allow HTTP port 80 to captive portal
        ether type ip ip protocol tcp tcp dport 80 accept

        # 4. Strictly DROP ALL OTHER PACKETS AT PHYSICAL INGRESS (both IPv4 and IPv6)
        ether saddr @quarantined_macs counter drop
    }
}

table inet secmynet {
    set quarantined_macs {
        type ether_addr
        comment "SecMyNet quarantined client MACs pending owner approval"
    }

    set quarantined_ips {
        type ipv4_addr
        comment "SecMyNet quarantined client IPv4s pending owner approval"
    }

    set quarantined_ip6s {
        type ipv6_addr
        comment "SecMyNet quarantined client IPv6s pending owner approval"
    }

    chain prerouting_nat {
        type nat hook prerouting priority -100; policy accept;
        # Redirect HTTP port 80 to router port 8080 for captive portal holding page
        ether saddr @quarantined_macs tcp dport 80 redirect to 8080
        ip saddr @quarantined_ips tcp dport 80 redirect to 8080
    }

    chain prerouting_filter {
        type filter hook prerouting priority -150; policy accept;

        # Allow local DHCP requests to router
        ether saddr @quarantined_macs udp dport 67 accept
        ether saddr @quarantined_macs udp dport 68 accept
        ip saddr @quarantined_ips udp dport 67 accept
        ip saddr @quarantined_ips udp dport 68 accept

        # Allow local DNS to router
        ether saddr @quarantined_macs udp dport 53 accept
        ether saddr @quarantined_macs tcp dport 53 accept
        ip saddr @quarantined_ips udp dport 53 accept
        ip saddr @quarantined_ips tcp dport 53 accept
        ip6 saddr @quarantined_ip6s udp dport 53 accept
        ip6 saddr @quarantined_ip6s tcp dport 53 accept

        # Allow HTTP port 80 to captive portal
        ether saddr @quarantined_macs tcp dport 80 accept
        ip saddr @quarantined_ips tcp dport 80 accept

        # DROP ALL OTHER PACKETS AT PREROUTING BEFORE CONNTRACK (IPv4 and IPv6)
        ether saddr @quarantined_macs counter drop
        ip saddr @quarantined_ips counter drop
        ip6 saddr @quarantined_ip6s counter drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # Allow local DHCP requests
        ether saddr @quarantined_macs udp dport 67 accept
        ether saddr @quarantined_macs udp dport 68 accept

        # Strictly DROP all other forwarding to Internet (WAN) for IPv4 and IPv6
        ether saddr @quarantined_macs counter drop
        ip saddr @quarantined_ips counter drop
        ip6 saddr @quarantined_ip6s counter drop
    }
}
