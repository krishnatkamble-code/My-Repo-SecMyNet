# /etc/nftables.d/secmynet-quarantine.nft
# SecMyNet Zero-Trust Quarantine-First Firewall Rules for OpenWrt (nftables)
#
# Blocks Internet (WAN) forwarding for all quarantined clients (both IPv4 and IPv6).
# Preserves local DNS/DHCP communication with the router.
# Redirects HTTP port 80 to port 8080 (SecMyNet Holding Captive Portal).

table inet secmynet {
    set quarantined_macs {
        type ether_addr
        flags interval
        comment "SecMyNet quarantined client MACs pending owner approval"
    }

    set quarantined_ips {
        type ipv4_addr
        flags interval
        comment "SecMyNet quarantined client IPv4s pending owner approval"
    }

    set quarantined_ip6s {
        type ipv6_addr
        flags interval
        comment "SecMyNet quarantined client IPv6s pending owner approval"
    }

    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
        # Redirect HTTP port 80 to router port 8080 for captive portal holding page
        ether saddr @quarantined_macs tcp dport 80 redirect to 8080
        ip saddr @quarantined_ips tcp dport 80 redirect to 8080
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # Always allow DNS (port 53) to router so phones can resolve captive portal hostnames
        ether saddr @quarantined_macs udp dport 53 accept
        ether saddr @quarantined_macs tcp dport 53 accept
        ip saddr @quarantined_ips udp dport 53 accept
        ip saddr @quarantined_ips tcp dport 53 accept
        ip6 saddr @quarantined_ip6s udp dport 53 accept
        ip6 saddr @quarantined_ip6s tcp dport 53 accept

        # Strictly DROP all other forwarding to Internet (WAN) for IPv4 and IPv6
        ether saddr @quarantined_macs counter drop
        ip saddr @quarantined_ips counter drop
        ip6 saddr @quarantined_ip6s counter drop
    }
}
